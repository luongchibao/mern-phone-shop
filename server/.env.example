# Server Environment Variables (Render & Local)
NODE_ENV=production
PORT=5000

# MongoDB Atlas URI (Ví dụ: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/phone_shop?retryWrites=true&w=majority)
MONGO_URI=mongodb://localhost:27017/phone_shop

# JWT Secret Token Key
JWT_SECRET=super_secret_jwt_key_please_change_in_production

# Frontend Client URL (Cho CORS và Cookie, có thể nhiều URL cách nhau bằng dấu phẩy)
CLIENT_URL=http://localhost:5173

# Optional: Cookie name (default: jwt)
COOKIE_NAME=jwt

# Optional: Email Service for reset password
EMAIL_USER=
EMAIL_PASSWORD=
